<div class="row g-3 mb-3">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between flex-wrap gap-2">
          <div>
            <h2 class="h5 mb-1"><%= c.libelle %> <span class="badge <%= c.cloturee ? 'text-bg-secondary' : 'bg-soft-or' %> align-middle"><%= c.cloturee ? 'Clôturée' : 'En cours' %></span></h2>
            <div class="text-muted small">Appel du <%= f.dateFr(c.date_appel) %><%= c.date_echeance ? ' · échéance le ' + f.dateFr(c.date_echeance) : '' %> · <%= f.fcfa(c.montant_par_adherent) %> par adhérent</div>
            <% if (c.motif) { %><p class="mt-2 mb-0"><%= c.motif %></p><% } %>
          </div>
        </div>
        <div class="row text-center mt-4 g-3">
          <div class="col-3"><div class="small text-muted">Attendu</div><div class="fw-bold"><%= f.fcfa(rec.du) %></div></div>
          <div class="col-3"><div class="small text-muted">Encaissé</div><div class="fw-bold text-success"><%= f.fcfa(rec.paye) %></div></div>
          <div class="col-3"><div class="small text-muted">Reste</div><div class="fw-bold text-danger"><%= f.fcfa(rec.reste) %></div></div>
          <div class="col-3"><div class="small text-muted">Recouvrement</div><div class="fw-bold"><%= rec.taux %> %</div></div>
        </div>
        <div class="progress mt-3"><div class="progress-bar" style="width: <%= rec.taux %>%"></div></div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header">Actions</div>
      <div class="card-body d-grid gap-2">
        <a href="/exports/exceptionnelle/<%= c.id %>.xlsx" class="btn btn-light"><i class="bi bi-file-earmark-excel text-success"></i> Exporter le recouvrement</a>
        <form method="post" action="/exceptionnelles/<%= c.id %>/cloture" class="d-grid">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-outline-secondary"><i class="bi <%= c.cloturee ? 'bi-unlock' : 'bi-lock' %>"></i> <%= c.cloturee ? 'Rouvrir' : 'Clôturer' %></button>
        </form>
        <% if (nonConcernes.length && !c.cloturee) { %>
          <form method="post" action="/exceptionnelles/<%= c.id %>/ajouter" class="input-group input-group-sm">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <select name="adherent_id" class="form-select">
              <% nonConcernes.forEach(a => { %><option value="<%= a.id %>"><%= a.nom %> <%= a.prenoms %></option><% }) %>
            </select>
            <button class="btn btn-outline-primary">Ajouter</button>
          </form>
        <% } %>
        <% if (rec.paye === 0) { %>
          <form method="post" action="/exceptionnelles/<%= c.id %>/supprimer" class="d-grid" data-confirm="Supprimer définitivement cette cotisation ?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Supprimer</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <ul class="nav nav-tabs card-header-tabs">
      <li class="nav-item"><a class="nav-link <%= !filtre ? 'active' : '' %>" href="?">Tous (<%= rec.lignes.length %>)</a></li>
      <li class="nav-item"><a class="nav-link <%= filtre === 'payes' ? 'active' : '' %>" href="?filtre=payes">Payés (<%= rec.nbPayeurs %>)</a></li>
      <li class="nav-item"><a class="nav-link <%= filtre === 'non_payes' ? 'active' : '' %>" href="?filtre=non_payes">Non payés (<%= rec.lignes.length - rec.nbPayeurs %>)</a></li>
    </ul>
  </div>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead><tr><th>Adhérent</th><th>Téléphone</th><th class="text-end">Dû</th><th class="text-end">Versé</th><th class="text-end">Reste</th><th>Situation</th><th></th></tr></thead>
      <tbody>
      <% lignes.forEach(l => { %>
        <tr>
          <td><a href="/adherents/<%= l.id %>"><%= l.nom %> <%= l.prenoms %></a> <span class="small text-muted"><%= l.matricule %></span></td>
          <td><%= l.telephone %></td>
          <td class="montant"><%= f.fcfa(l.du) %></td>
          <td class="montant"><%= f.fcfa(l.paye) %></td>
          <td class="montant <%= l.reste ? 'text-danger fw-semibold' : '' %>"><%= f.fcfa(l.reste) %></td>
          <td>
            <% if (l.reste === 0) { %><span class="badge badge-etat etat-a_jour">Payé</span>
            <% } else if (l.paye > 0) { %><span class="badge badge-etat etat-partiel">Partiel</span>
            <% } else { %><span class="badge badge-etat etat-impaye">Non payé</span><% } %>
          </td>
          <td class="text-end text-nowrap">
            <% if (l.reste > 0 && !c.cloturee) { %>
              <a href="/versements/nouveau?adherent=<%= l.id %>&type=exceptionnelle&exc=<%= c.id %>" class="btn btn-sm btn-primary"><i class="bi bi-cash-coin"></i> Encaisser</a>
            <% } %>
            <% if (l.paye === 0) { %>
              <form method="post" action="/exceptionnelles/<%= c.id %>/retirer" class="d-inline" data-confirm="Retirer cet adhérent de la cotisation ?">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="hidden" name="adherent_id" value="<%= l.id %>">
                <button class="btn btn-sm btn-light" title="Retirer"><i class="bi bi-x-lg"></i></button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (!lignes.length) { %><tr><td colspan="7" class="empty-state"><i class="bi bi-inbox"></i>Aucun adhérent dans cette liste.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
