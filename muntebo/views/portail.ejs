<% const resteExc = exceptionnelles.reduce((s, e) => s + e.reste, 0); %>
<div class="card mb-3" style="background:linear-gradient(120deg,#1e6b23,#2e8b2a);color:#fff;border:0">
  <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 p-4">
    <div class="d-flex align-items-center gap-3">
    <% if (a.photo) { %><img src="/portail/photo" alt="Ma photo" class="fiche-photo" style="width:76px;height:90px;border-color:rgba(255,255,255,.5)"><% } %>
    <div>
      <div style="color:#bfe0cc">Bienvenue,</div>
      <h2 class="h3 mb-1"><%= a.prenoms %> <%= a.nom %></h2>
      <div style="color:#bfe0cc"><%= a.matricule %> · <%= a.categorie %> · membre depuis le <%= f.dateFr(a.date_adhesion) %></div>
      <a href="/portail/carte.pdf" target="_blank" class="btn btn-sm btn-light mt-2"><i class="bi bi-person-vcard text-success"></i> Ma carte de membre</a>
    </div>
    </div>
    <div class="text-end">
      <% if (situation.reste + resteExc === 0) { %>
        <div class="fs-4 fw-bold"><i class="bi bi-patch-check-fill" style="color:var(--mt-or)"></i> À jour</div>
        <div style="color:#bfe0cc">Merci pour votre engagement !</div>
      <% } else { %>
        <div style="color:#bfe0cc">Reste à payer</div>
        <div class="fs-3 fw-bold"><%= f.fcfa(situation.reste + resteExc) %></div>
      <% } %>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-xl-7">
    <div class="card mb-3">
      <div class="card-header">Mes cotisations normales <span class="text-muted fw-normal small">— <%= f.fcfa(a.categorie_montant) %> / <%= params.periodicite === 'annuelle' ? 'an' : 'mois' %></span></div>
      <div class="card-body"><%- include('partials/situation', { situation }) %></div>
    </div>
    <div class="card">
      <div class="card-header">Mes cotisations exceptionnelles</div>
      <%- include('partials/exceptionnelles-adherent', { exceptionnelles }) %>
    </div>
  </div>
  <div class="col-xl-5">
    <div class="card mb-3">
      <div class="card-header">Mes versements et reçus</div>
      <ul class="list-group list-group-flush">
        <% versements.forEach(v => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold"><%= f.fcfa(v.montant) %></div>
              <div class="small text-muted"><%= f.dateFr(v.date_versement) %> · <%= v.type === 'normale' ? f.libellePeriode(v.periode) : v.exc_libelle %></div>
            </div>
            <a href="/portail/recu/<%= v.id %>.pdf" target="_blank" class="btn btn-sm btn-light"><i class="bi bi-file-earmark-pdf text-danger"></i> Reçu</a>
          </li>
        <% }) %>
        <% if (!versements.length) { %><li class="list-group-item empty-state"><i class="bi bi-inbox"></i>Aucun versement enregistré.</li><% } %>
      </ul>
    </div>
    <div class="card">
      <div class="card-header d-flex justify-content-between">Derniers PV publiés <a href="/pv" class="small fw-normal">Tout voir</a></div>
      <ul class="list-group list-group-flush">
        <% pv.forEach(p => { %>
          <li class="list-group-item d-flex gap-3 align-items-center">
            <div class="pv-icone"><i class="bi bi-file-earmark-text"></i></div>
            <div><a href="/pv/<%= p.id %>" class="fw-semibold"><%= p.titre %></a><div class="small text-muted"><%= p.type_reunion %> · <%= f.dateFr(p.date_reunion) %></div></div>
          </li>
        <% }) %>
        <% if (!pv.length) { %><li class="list-group-item empty-state"><i class="bi bi-folder2-open"></i>Aucun PV publié.</li><% } %>
      </ul>
    </div>
  </div>
</div>
